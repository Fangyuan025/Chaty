<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shown in the macOS permission prompt the first time voice/live mode
       accesses the microphone. Without this key WKWebView crashes on mic use. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Chaty uses the microphone for hands-free voice chat and speech-to-text.</string>
</dict>
</plist>
