<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Narrow file APIs read paths in the process code page. UTF-8 here (Windows
     10 1903+) is what lets the engine open a model under a user folder whose
     name is not ASCII; main.cpp falls back to 8.3 short paths where it is not
     honoured. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity type="win32" name="Chaty.ImageEngine" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
